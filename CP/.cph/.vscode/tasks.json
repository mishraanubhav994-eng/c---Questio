{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build with g++-15",
            "command": "/opt/homebrew/bin/g++-15",
            "args": [
                "-std=c++17",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}